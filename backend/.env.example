# Supabase (Phase 0에서 프로젝트 생성 후 채워넣기)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres 직접 연결 문자열 (LangGraph checkpointer용, REST service-role과는 별개) - Supabase 대시보드 Project Settings > Database > Connection string (Session pooler) 에서 발급
SUPABASE_DB_URL=

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAILS=ceo@charislab.kr

# Telegram Bot (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=
# 실배포 후 setWebhook 호출 시 secret_token으로 같이 넘기면 텔레그램이 매 webhook 요청에
# X-Telegram-Bot-Api-Secret-Token 헤더로 이 값을 실어보낸다 (위조 요청 방지). 로컬 개발 중엔 비워둬도 됨.
TELEGRAM_WEBHOOK_SECRET=

# 로그인 세션 토큰(JWT) 서명용 시크릿 - 절대 노출/재사용 금지, 변경 시 기존 로그인 세션 전부 무효화됨
SESSION_SECRET=
SESSION_TTL_HOURS=12

# 소셜 포스팅 어댑터 스위치 (mock|meta|tiktok) - ARCHITECTURE.md 5번 참고
SOCIAL_ADAPTER=mock

# Meta Graph API (승인 후 채워넣기)
META_APP_ID=
META_APP_SECRET=
# 장기(비만료) Page Access Token — 발급 방법: docs/EXTERNAL_APIS.md 참고
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok API (승인 후 채워넣기)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI 모델 Provider (ARCHITECTURE.md 7번 참고 - 특정 벤더에 고정하지 않음)
LLM_PROVIDER=claude
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=sora
VISION_PROVIDER=gemini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Google Calendar MCP (외부 캘린더 동기화, Phase 1은 비활성 유지 - ARCHITECTURE.md 6번 참고)
GOOGLE_CALENDAR_MCP_ENABLED=false
